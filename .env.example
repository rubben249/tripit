# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to client code —
# never put secrets (service role keys, etc.) behind that prefix.

# Shown in the UI; change any time without touching code.
EXPO_PUBLIC_APP_NAME=TripIt
EXPO_PUBLIC_DEFAULT_CURRENCY=EUR

# Public address of the deployed web app. Share QRs point here, because the
# device generating them may be on localhost, a LAN IP or a native build —
# none of which the receiving phone can open. No trailing slash.
EXPO_PUBLIC_WEB_URL=https://tripit-app.github.io

# Supabase project (Fase 1 — filled in once the project is created).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
