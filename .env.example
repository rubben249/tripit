# Copy to .env and fill in. Only EXPO_PUBLIC_* vars are exposed to client code —
# never put secrets (service role keys, etc.) behind that prefix.
#
# Everything here is also what you set in the Netlify panel (Site configuration
# -> Environment variables). They are inlined into the bundle at build time, so
# they must be available to the *build*, not only at runtime.

# Shown in the UI and in the installed PWA; change any time without touching code.
EXPO_PUBLIC_APP_NAME=TripIt
# Home-screen label under the icon. Optional — defaults to EXPO_PUBLIC_APP_NAME.
# Set it when the full name is too long to fit (iOS/Android truncate ~12 chars).
EXPO_PUBLIC_APP_SHORT_NAME=
# Shown in the browser's install prompt and as the page description. Optional —
# defaults to the one in src/config/brand.json.
EXPO_PUBLIC_APP_DESCRIPTION=
EXPO_PUBLIC_DEFAULT_CURRENCY=EUR

# Supabase project. The anon key is public by design (it ends up in the web
# bundle); it is the RLS policies, not this key, that keep data private.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only when the web app is NOT served from a domain root (e.g. a GitHub Pages
# project site, /<repo>/). Leave empty for the Netlify deploy.
EXPO_WEB_BASE_PATH=
